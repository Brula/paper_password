<div class="min-h-[60vh] flex flex-col items-center justify-center text-center">
  <h1 class="text-6xl font-extrabold text-brand mb-4">404</h1>
  <h2 class="text-2xl font-bold mb-2">Page Not Found</h2>
  <p class="mb-6 text-zinc-600 dark:text-zinc-300">
    Sorry, the page you are looking for does not seem to exist or has been moved.
  </p>
  <a
    href="/"
    class="inline-block rounded bg-brand text-white px-6 py-3 font-semibold shadow hover:bg-brand/90 transition"
  >
    Go to Homepage
  </a>
</div>
