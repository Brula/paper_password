<header class="w-full border-b dark:border-zinc-800 print:hidden bg-white/80 dark:bg-zinc-900/80 backdrop-blur-lg sticky top-0 z-10">
  <div class="mx-auto max-w-4xl flex items-center justify-between px-4 sm:px-6 lg:px-8 py-4">
    <a href="/" class="flex items-center gap-2">
      <span class="text-2xl leading-none" role="img" aria-label="Paper Password logo">🐳🔒</span>
      <span class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Paper Password
      </span>
    </a>
    <button
      id="darkmode-toggle"
      class="p-2 rounded text-sm font-medium text-zinc-700 dark:text-zinc-100 hover:bg-zinc-200 dark:hover:bg-zinc-800"
      title="Toggle dark mode"
      type="button"
    >
      Dark mode
    </button>
  </div>
</header>

<main class="px-4 py-20 sm:px-6 lg:px-8 print:p-0">
  <div class="mx-auto max-w-4xl">
    <.connection_banners />
    {@inner_content}
  </div>
</main>

<footer class="w-full border-t dark:border-zinc-800 print:hidden bg-white mt-20 dark:bg-zinc-900">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8 text-center text-sm text-zinc-500">
    <div class="dark:text-zinc-100">
      &copy; 2026
      <a
        href="https://infinite8.nl"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline"
      >
        Infinite8
      </a>
      &middot;
      <a
        href="https://github.com/Brula/paper_password"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline"
      >
        Source Code
      </a>
    </div>
  </div>
</footer>
